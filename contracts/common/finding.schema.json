{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/liyuhan7/devops-build-toolchain-05/contracts/common/finding.schema.json",
  "title": "DependencyFinding",
  "description": "A dependency-analysis result. MISSING and REDUNDANT are findings, not job execution errors.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "finding_id",
    "source_commit",
    "configuration_id",
    "target",
    "location",
    "category",
    "severity",
    "message",
    "dependency",
    "evidence"
  ],
  "properties": {
    "finding_id": {
      "type": "string",
      "minLength": 1
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{7,40}$"
    },
    "configuration_id": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": "string",
      "minLength": 1,
      "description": "Module, image, project, or other analysis target."
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "category": {
      "type": "string",
      "enum": ["MISSING", "REDUNDANT"]
    },
    "severity": {
      "type": "string",
      "enum": ["INFO", "WARNING", "ERROR"]
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ecosystem", "name"],
      "properties": {
        "ecosystem": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/liyuhan7/devops-build-toolchain-05/contracts/common/artifact.schema.json",
  "title": "Artifact",
  "description": "A versioned artifact exchanged between E2 services.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id",
    "kind",
    "uri",
    "media_type",
    "sha256",
    "produced_by_job_id",
    "source_commit",
    "configuration_digest",
    "created_at"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "minLength": 1,
      "description": "Stable artifact type, for example BUILD_LOG or DEPENDENCY_GRAPH."
    },
    "uri": {
      "type": "string",
      "format": "uri",
      "description": "Location from which the consumer reads the artifact."
    },
    "media_type": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "produced_by_job_id": {
      "type": "string",
      "minLength": 1
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{7,40}$"
    },
    "configuration_digest": {
      "type": "string",
      "minLength": 1,
      "description": "Digest or immutable identifier of the configuration used to produce the artifact."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
